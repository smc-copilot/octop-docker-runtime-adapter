# Copy to setup.env (chmod 600) for per-host defaults.
# CLI flags override these values. Do not put secrets here.
INSTANCE_ID=octop-bc02
SANDBOX_PREFIX=octop_sandbox_bc02
WORKSPACE_ROOT=/home/smc/.octop/user-workspaces/octop-bc02
BACKEND_IMAGE=octop-sandbox:2026.11-base
MEMORY=2g
CPUS=2
PIDS_LIMIT=512
COMMAND_TIMEOUT=120
# Seconds to wait for /api/health after the service restart (default 180).
HEALTH_TIMEOUT=180
SMOKE_URL=https://api.github.com/zen
